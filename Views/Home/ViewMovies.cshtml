@{
}

@model List<mission07_fairbanks.Models.Movie>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Category</th>
            <th>Title</th>
            <th>Year</th>
            <th>Director</th>
            <th>Rating</th>
            <th>Edited</th>
            <th>Lent To</th>
            <th>Copied to Plex</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Category?.CategoryName</td>  <!-- Display CategoryName from navigation property -->
                <td>@movie.Title</td>
                <td>@movie.Year</td>
                <td>@movie.Director</td>
                <td>@movie.Rating</td>
                <td>@movie.Edited</td>
                <td>@movie.LentTo</td>
                <td>@movie.CopiedToPlex</td>
                <td>@movie.Notes</td>
                <td>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("Edit", "Home", new { id = movie.MovieId })">Edit</a>
                </td>
                <td>
                    <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", "Home", new { id = movie.MovieId })">Delete</a>
                </td>
            </tr>
        }
    </tbody>


</table>


