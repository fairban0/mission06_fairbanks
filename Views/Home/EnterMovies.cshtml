
@{
    ViewData["Title"] = "EnterMovies";
}

@model mission07_fairbanks.Models.Movie

<h1>Enter Movie into Database</h1>

<!-- Success message -->
@if (ViewData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @ViewData["SuccessMessage"]
    </div>
}

<form asp-action="EnterMovies" method="post">
    <!--CATEGORY-->
    <label asp-for="CategoryId">Category:</label>
    <select asp-for="CategoryId" class="form-control" required>
        <option value="7">Action/Adventure</option>
        <option value="5">Comedy</option>
        <option value="2">Drama</option>
        <option value="6">Family</option>
        <option value="4">Horror/Suspense</option>
        <option value="1">Miscellaneous</option>
        <option value="3">Television</option>
        <option value="8">VHS</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
    <br />

    <!--TITLE-->
    <label asp-for="Title">Title:</label>
    <input asp-for="Title" class="form-control" maxlength="200" required />
    <span asp-validation-for="Title" class="text-danger"></span>

    <!--YEAR-->
    <label asp-for="Year">Year:</label>
    <input asp-for="Year" type="number" class="form-control" required min="1888" max="2100" />
    <span asp-validation-for="Year" class="text-danger"></span>

    <!--DIRECTOR-->
    <label asp-for="Director">Director:</label>
    <input asp-for="Director" class="form-control" maxlength="100" required />
    <span asp-validation-for="Director" class="text-danger"></span>

    <!--RATING-->
    <label asp-for="Rating">Rating:</label>
    <select asp-for="Rating" class="form-control" required>
        <option value="NR">NR</option>
        <option value="G">G</option>
        <option value="PG">PG</option>
        <option value="PG-13">PG-13</option>
        <option value="R">R</option>
    </select>
    <span asp-validation-for="Rating" class="text-danger"></span>
    <br />

    <!--EDITED (Optional)-->
    <label asp-for="Edited">Edited (optional):</label>
    <select asp-for="Edited" class="form-control">
        <option value="False">No</option>
        <option value="True">Yes</option>
    </select>
    <span asp-validation-for="Edited" class="text-danger"></span>
    <br />

    <!--LENT (Optional)-->
    <label asp-for="LentTo">Lent (optional):</label>
    <select asp-for="LentTo" class="form-control">
        <option value="False">No</option>
        <option value="True">Yes</option>
    </select>
    <span asp-validation-for="LentTo" class="text-danger"></span>
    <br />

    <!--RATING-->
    <label asp-for="CopiedToPlex">Copied To Plex:</label>
    <select asp-for="CopiedToPlex" class="form-control">
        <option value="False">No</option>
        <option value="True">Yes</option>
    </select>
    <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
    <br />

    <!--NOTES (Optional, max 25 chars)-->
    <label asp-for="Notes">Notes (optional):</label>
    <input asp-for="Notes" class="form-control" maxlength="25" />
    <span asp-validation-for="Notes" class="text-danger"></span>

    <br />
    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary">Submit</button>
</form>




